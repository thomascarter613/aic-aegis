{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic-aegis.local/schemas/mvp-a/timeline.schema.json",
  "title": "Timeline",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mvp-a.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeline_item_id": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "event_type": {
            "$ref": "enums.schema.json#/$defs/EventType"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "record_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "record_type": {
                  "type": "string",
                  "minLength": 1
                },
                "record_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "record_type",
                "record_id"
              ]
            }
          }
        },
        "required": [
          "timeline_item_id",
          "occurred_at",
          "event_type",
          "title",
          "record_refs"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "items"
  ]
}
