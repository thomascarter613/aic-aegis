{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic-aegis.local/schemas/mvp-a/run-event.schema.json",
  "title": "Run Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mvp-a.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "$ref": "enums.schema.json#/$defs/EventType"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "event_type",
    "event_version",
    "occurred_at",
    "payload"
  ]
}
