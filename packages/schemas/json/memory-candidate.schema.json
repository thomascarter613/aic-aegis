{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.dev/aegis/schemas/memory-candidate.schema.json",
  "title": "MemoryCandidate",
  "type": "object",
  "required": ["tenant_id", "subject_type", "memory_type", "content", "source_type", "source_ref"],
  "properties": {
    "tenant_id": { "type": "string" },
    "subject_type": { "type": "string" },
    "subject_id": { "type": "string" },
    "memory_type": {
      "type": "string",
      "enum": ["working", "episodic", "semantic", "procedural", "evaluative"]
    },
    "content": { "type": "string" },
    "source_type": { "type": "string" },
    "source_ref": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "ttl_days": { "type": "integer", "minimum": 0 },
    "write_reason": { "type": "string" },
    "requires_human_confirmation": { "type": "boolean" }
  },
  "additionalProperties": false
}
