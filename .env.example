# AIC Aegis local development environment

APP_ENV=local
APP_NAME=AIC_AEGIS
APP_PORT=8080
ADMIN_UI_PORT=3000

DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

OPA_URL=http://localhost:8181
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Do not put real provider keys here.
# Use local models or explicitly managed secrets for real deployments.
LLM_PROVIDER=mock
LLM_MODEL=mock-model

AIC_TENANT_ID=tenant_demo
AIC_DEFAULT_AGENT_ID=agent_sales_ops
